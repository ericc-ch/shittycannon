{
  "tasks": {
    "check": "deno task typecheck && deno task test && deno task lint && deno fmt --check",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "start": "deno run -A src/main.ts",
    "test": "deno test -A --permit-no-files test/",
    "typecheck": "deno check src/ test/"
  },
  "imports": {
    "@effect/platform-deno": "npm:@effect/platform-deno@^4.0.0-rc.112",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "effect": "npm:effect@^4.0.0-rc.112"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "fmt": {
    "semiColons": false
  },
  "lint": {
    "rules": {
      "include": [
        "ban-untagged-todo",
        "default-param-last",
        "eqeqeq",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-boolean-literal-for-arguments",
        "no-eval",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-sparse-arrays",
        "no-throw-literal",
        "no-useless-rename",
        "verbatim-module-syntax"
      ],
      "tags": ["recommended"]
    }
  }
}
